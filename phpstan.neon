parameters:
    level: 8
    paths:
        - src
    excludePaths:
        - tests/
        - var/*
        - vendor/*
    ignoreErrors:
        # Ignorer les erreurs liées à Doctrine pour l'instant
        - '#Property App\\Match\\Infrastructure\\Persistence\\Doctrine\\Entity\\MatchEntity::\$id \(int\|null\) is never assigned int#'
        - '#Property App\\Match\\Infrastructure\\Persistence\\Doctrine\\Entity\\ParticipantEntity::\$id \(int\|null\) is never assigned int#'
