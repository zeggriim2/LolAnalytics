<h2>Détails du match {{ match.id }}</h2>

<p><strong>Durée :</strong> {{ match.durationSeconds }}s</p>

<h3>Participants</h3>
<table>
    <thead>
    <tr>
        <th>Summoner</th>
        <th>Champion</th>
        <th>Win</th>
        <th>Kills</th>
        <th>Deaths</th>
        <th>Assists</th>
    </tr>
    </thead>
    <tbody>
    {% for p in match.participants %}
        <tr>
            <td>{{ p.summonerId }}</td>
            <td>{{ p.championId }}</td>
            <td>{{ p.win ? '✅' : '❌' }}</td>
            <td>{{ p.kda.kills }}</td>
            <td>{{ p.kda.deaths }}</td>
            <td>{{ p.kda.assists }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>

